    else o[k]={entries:v.entries.filter(EN[k]).map(e=>({...e}))}}
  return o}
function de(o,z){const v={};
  for(const k of KEYS){let x=o[k];if(E[k](x))continue;
    if(k==="photos")x={items:x.items.filter(p=>z[p.file]).map(p=>({type:p.type,blob:new Blob([z[p.file]],{type:p.type})}))};
    else if(k==="song")x={entries:x.entries.map(e=>({...e,img:e.img&&e.img.file&&z[e.img.file]?{type:e.img.type,blob:new Blob([z[e.img.file]],{type:e.img.type})}:undefined}))};
