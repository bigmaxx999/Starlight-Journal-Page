  if(e<0)throw new Error("That doesn’t look like a zip file.");
  const n=v.getUint16(e+10,true);let p=v.getUint32(e+16,true);
  for(let i=0;i<n;i++){
    if(v.getUint32(p,true)!==0x02014b50)throw new Error("The zip file looks damaged.");
    const m=v.getUint16(p+10,true),cs=v.getUint32(p+20,true),nl=v.getUint16(p+28,true),xl=v.getUint16(p+30,true),cl=v.getUint16(p+32,true),lo=v.getUint32(p+42,true);
    const name=dec.decode(u.subarray(p+46,p+46+nl)),s=lo+30+v.getUint16(lo+26,true)+v.getUint16(lo+28,true);
    let d=u.subarray(s,s+cs);
    if(m===8){if(!window.DecompressionStream)throw new Error("This zip is compressed in a way this browser can’t open.");
