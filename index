<script>
"use strict";
const $=s=>document.querySelector(s);
const pad=n=>String(n).padStart(2,"0");
const ymd=d=>d.getFullYear()+"-"+pad(d.getMonth()+1)+"-"+pad(d.getDate());
const parse=s=>{const[a,b,c]=s.split("-").map(Number);return new Date(a,b-1,c)};
const today=()=>ymd(new Date());
const EN={journal:e=>(e.text||"").trim(),idea:e=>(e.text||"").trim(),wins:e=>(e.text||"").trim(),mood:e=>e.value||(e.why||"").trim(),song:e=>e.title||e.artist||e.link||e.img,where:e=>e.lat!=null||(e.place||"").trim()};
const E={};for(const k in EN)E[k]=v=>!v||!(v.entries||[]).some(EN[k]);
E.photos=v=>!v||!(v.items||[]).length;
const KEYS=Object.keys(E);
function upMod(k,v){if(!v||v.entries||k==="photos")return v;const tt=x=>(x||"").trim();
  if(k==="journal"||k==="idea")return tt(v.text)?{entries:[{time:"",text:v.text}]}:undefined;
  if(k==="wins")return{entries:(v.items||[]).filter(tt).map(x=>({time:"",text:x}))};
  if(k==="mood")return(v.value||tt(v.why))?{entries:[{time:"",value:v.value,why:v.why||""}]}:undefined;
  if(k==="song")return{entries:[{time:"",title:v.title,artist:v.artist,link:v.link,img:v.img}]};
  if(k==="where")return{entries:[{time:"",place:v.place,lat:v.lat,lon:v.lon,acc:v.acc}]};
  return v}
function upRec(r){if(r)for(const k of KEYS)if(r[k])r[k]=upMod(k,r[k]);return r}
let db=null,mem=new Map(),cur=today(),calM=parse(cur),R=null,dirty=false,timer=null,dl=null,urls=[];

/* ---------- storage ---------- */
function openDB(){return new Promise(res=>{try{const r=indexedDB.open("journal-app",1);r.onupgradeneeded=()=>r.result.createObjectStore("days",{keyPath:"date"});r.onsuccess=()=>res(r.result);r.onerror=r.onblocked=()=>res(null)}catch(e){res(null)}})}
function rq(fn,mode){return new Promise(res=>{try{const t=db.transaction("days",mode||"readonly");const r=fn(t.objectStore("days"));t.oncomplete=()=>res(r&&r.result);t.onerror=t.onabort=()=>res(null)}catch(e){res(null)}})}
async function getDay(d){return upRec(db?(await rq(s=>s.get(d)))||null:mem.get(d)||null)}
async function putDay(r){if(db)await rq(s=>s.put(r),"readwrite");else mem.set(r.date,r)}
async function allDays(){return(db?(await rq(s=>s.getAll()))||[]:[...mem.values()]).map(upRec)}
async function clearAll(){if(db)await rq(s=>s.clear(),"readwrite");else mem.clear()}
function touch(){dirty=true;clearTimeout(timer);timer=setTimeout(flush,500)}
async function flush(){clearTimeout(timer);if(!dirty||!R)return;dirty=false;R.updated=new Date().toISOString();await putDay(R);const s=$("#sv");if(s&&s.animate&&!reduce){s.textContent="Saved";s.animate([{opacity:0},{opacity:.9,offset:.15},{opacity:.9,offset:.65},{opacity:0}],{duration:1600})}}
const url=b=>{const u=URL.createObjectURL(b);urls.push(u);return u};

/* ---------- day view ---------- */
async function renderDay(){
  urls.forEach(URL.revokeObjectURL);urls=[];
  R=await getDay(cur)||{date:cur};
  const d=parse(cur),o={weekday:"short",month:"short",day:"numeric"};
  if(d.getFullYear()!==new Date().getFullYear())o.year="numeric";
  const T=$("#ttl");T.innerHTML="";[["dn",d.getDate()],["dm",d.toLocaleDateString(undefined,{weekday:"short"})+" · "+d.toLocaleDateString(undefined,{month:"short"})+(d.getFullYear()!==new Date().getFullYear()?" "+String(d.getFullYear()).slice(2):"")]].forEach(([c,x])=>{const e=document.createElement("span");e.className=c;e.textContent=x;T.appendChild(e)});
  drawPhotos();drawPlanets();
}
function drawPhotos(){const it=(R.photos||{}).items||[],m=$("#mos");m.innerHTML="";
  $("#pc").textContent=it.length?it.length:"";
  if(!it.length){m.innerHTML="<span>No photos yet</span>";return}
  it.forEach(p=>{const i=document.createElement("img");i.src=url(p.blob);m.appendChild(i)})}
function drawViewer(){const v=$("#viewer"),it=(R.photos||{}).items||[];v.innerHTML="";
  if(!it.length){$("#mPh").hidden=true;return}
  it.forEach((p,i)=>{const f=document.createElement("figure"),m=document.createElement("img");m.src=url(p.blob);
    const b=document.createElement("button");b.className="mini";b.textContent="Delete photo "+(i+1)+" of "+it.length;
    b.onclick=async()=>{it.splice(i,1);touch();await flush();drawPhotos();drawViewer()};
    f.append(m,document.createElement("br"),b);v.appendChild(f)})}
